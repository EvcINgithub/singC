<Page
    x:Class="singC.Pages.NetworkTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:singC.Models"
    xmlns:converters="using:singC.Converters"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <converters:NetworkTestStatusToBrushConverter x:Key="StatusBrush"/>
        <DataTemplate x:Key="ResultTemplate" x:DataType="models:NetworkTestResult">
            <Border Padding="16" Margin="0,0,0,8" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="12" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="16"
                              Foreground="{x:Bind Status, Converter={StaticResource StatusBrush}}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{x:Bind DurationText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind StatusText}"
                                   Foreground="{x:Bind Status, Converter={StaticResource StatusBrush}}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind Detail}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{x:Bind Advice}"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="18" MaxWidth="1100" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="网络诊断" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="检查哪些网站能访问，再定位域名解析、连接或网站响应问题。"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Padding="18" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="10">
                        <TextBox x:Name="TestUrlBox" Header="要排查的网址"
                                 PlaceholderText="https://github.com/" HorizontalAlignment="Stretch"/>
                        <StackPanel x:Name="PresetPanel" Orientation="Horizontal" Spacing="8">
                            <Button Content="百度" Tag="https://www.baidu.com/" Click="PresetButton_Click"/>
                            <Button Content="GitHub" Tag="https://github.com/" Click="PresetButton_Click"/>
                            <Button Content="Google" Tag="https://www.google.com/" Click="PresetButton_Click"/>
                        </StackPanel>
                        <CheckBox x:Name="CommonSitesCheckBox" IsChecked="True"
                                  Content="同时检查百度、GitHub、Google，方便对照"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RunDiagnosticsButton" Content="一键诊断"
                                Style="{StaticResource AccentButtonStyle}" Click="RunDiagnosticsButton_Click"/>
                        <Button x:Name="RunStabilityButton" Content="连续请求 10 次"
                                ToolTipService.ToolTip="仅测试上方网址，查看是否偶发失败及响应耗时"
                                Click="RunStabilityButton_Click"/>
                        <Button x:Name="CancelButton" Content="取消" Visibility="Collapsed"
                                Click="CancelButton_Click" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock Text="无需手填主机或端口。HTTP 请求跟随当前系统代理、TUN 和路由规则。"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Expander x:Name="AdvancedExpander" Header="高级选项" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12">
                    <NumberBox x:Name="TimeoutBox" Header="单项超时（秒）" Minimum="1" Maximum="30"
                               Value="5" SmallChange="1" SpinButtonPlacementMode="Compact" Width="200" HorizontalAlignment="Left"/>
                    <CheckBox x:Name="CheckExitIpBox" Content="一键诊断时查询当前出口 IP" IsChecked="True"/>
                    <TextBox x:Name="ExitIpBox" Header="出口 IP 查询服务"
                             PlaceholderText="https://api.ipify.org?format=json"/>
                    <TextBlock Text="出口地址是查询服务看到的结果；不同网站可能走不同路由。连续请求测试不查询出口 IP。"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Expander>

            <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressRing x:Name="TestProgress" Width="24" Height="24" IsActive="False" Visibility="Collapsed"/>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock x:Name="SummaryTextBlock" Text="点击「一键诊断」开始，无需先启动 sing-box。"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <TextBlock x:Name="LastRunTextBlock" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                    <Button x:Name="CopyReportButton" Content="复制报告" Click="CopyReportButton_Click"
                            IsEnabled="False" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <StackPanel Spacing="10">
                <TextBlock x:Name="ResultHeading" Text="网站连通性" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock x:Name="EmptyResultsText" Text="测试后会在这里逐项显示网站的响应与排查建议。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ItemsControl ItemsSource="{x:Bind WebsiteResults}" ItemTemplate="{StaticResource ResultTemplate}"/>
            </StackPanel>

            <Expander x:Name="DetailsExpander" Header="连接与环境详情" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="10">
                    <TextBlock Text="查看目标网址的 DNS、TCP 和本机状态。DNS/TCP 使用系统网络，不使用 HTTP 代理；不同检查的路径可能不同。"
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{x:Bind DetailResults}" ItemTemplate="{StaticResource ResultTemplate}"/>
                </StackPanel>
            </Expander>

            <Expander Header="最近 10 次测试 · 点击查看完整报告" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <ListView ItemsSource="{x:Bind History}" IsItemClickEnabled="True" ItemClick="HistoryList_ItemClick"
                          SelectionMode="None" MaxHeight="300">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:NetworkTestRunSummary">
                            <StackPanel Spacing="4" Padding="4,8">
                                <TextBlock Text="{x:Bind DisplayText}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind FailureDisplayText}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Expander>
            <TextBlock x:Name="StorageMessageText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</Page>
