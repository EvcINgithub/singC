<Page
    x:Class="singC.Pages.SettingsPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:singC.Converters"
    xmlns:models="using:singC.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="管理运行路径、配置文件和路由规则"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
                <Border Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="应用更新" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock x:Name="AppVersionText"/>
                        <ToggleSwitch x:Name="AutoUpdateToggle" Header="每 24 小时自动检查更新" Toggled="AutoUpdateToggle_Toggled"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate_Click"/>
                            <Button x:Name="InstallUpdateButton" Content="下载并重启更新" Click="InstallUpdate_Click" IsEnabled="False"/>
                            <Button x:Name="CancelUpdateButton" Content="取消下载" Click="CancelUpdate_Click" Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock x:Name="AppUpdateStatus" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" MaxHeight="220" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Padding="14" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="个人服务" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="地址保存在本机，留空则不连接。请输入完整的 HTTP 或 HTTPS 地址。" TextWrapping="Wrap"/>
                        <TextBox x:Name="TrafficServiceUrlBox" Header="流量查询接口" PlaceholderText="https://example.com/traffic"/>
                        <Button Content="保存服务地址" Click="SaveServiceUrls_Click"/>
                        <TextBlock x:Name="ServiceUrlStatus" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Text="路径设置" Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Sing-Box" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBox Grid.Column="1"
                                     Text="{x:Bind ViewModel.SingBoxPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="例如：C:\sing-box\sing-box.exe"/>
                            <Button Grid.Column="2" Command="{x:Bind ViewModel.BrowseSingBoxCommand}" ToolTipService.ToolTip="选择 Sing-Box 可执行文件">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                            </Button>

                            <TextBlock Grid.Row="1" Text="配置文件" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{x:Bind ViewModel.ConfigPaths}"
                                      SelectedItem="{x:Bind ViewModel.SelectedConfigPath, Mode=TwoWay}"
                                      PlaceholderText="选择要加载的配置文件"
                                      HorizontalAlignment="Stretch"/>
                            <Button Grid.Row="1" Grid.Column="2" Command="{x:Bind ViewModel.BrowseConfigCommand}" ToolTipService.ToolTip="添加配置文件">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="3" Command="{x:Bind ViewModel.RemoveConfigCommand}" ToolTipService.ToolTip="移除当前配置">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            </Button>

                            <TextBlock Grid.Row="2" Text="背景图片" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{x:Bind ViewModel.BackgroundImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="选择一张图片作为背景"/>
                            <Button Grid.Row="2" Grid.Column="2" Command="{x:Bind ViewModel.BrowseBackgroundCommand}" ToolTipService.ToolTip="选择背景图片">
                                <FontIcon Glyph="&#xEB9F;" FontSize="14"/>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="3" Command="{x:Bind ViewModel.ClearBackgroundCommand}" ToolTipService.ToolTip="清除背景">
                                <FontIcon Glyph="&#xE894;" FontSize="14"/>
                            </Button>
                        </Grid>
                        <ToggleSwitch Header="开机启动"
                                      IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <Border Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="配置备份" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock Text="保存配置时自动保留最近 10 份备份。"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.LoadConfigCommand}"
                                    ToolTipService.ToolTip="重新加载当前配置">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            </Button>
                        </Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.ConfigBackups}"
                                  SelectionMode="None"
                                  MaxHeight="150"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ConfigBackupInfo">
                                    <Grid ColumnSpacing="8" Padding="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind DisplayText}"
                                                   IsTextSelectionEnabled="True"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button Command="{Binding ElementName=ThisPage, Path=ViewModel.RestoreBackupCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTipService.ToolTip="恢复此备份">
                                                <FontIcon Glyph="&#xE777;" FontSize="13"/>
                                            </Button>
                                            <Button Command="{Binding ElementName=ThisPage, Path=ViewModel.DeleteBackupCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTipService.ToolTip="删除此备份">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid RowSpacing="10" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Spacing="2">
                                <TextBlock Text="Sing-Box 配置" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock Text="选择匹配类型编辑规则，复杂条件可切换高级 JSON"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="有未保存修改"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"
                                           Visibility="{x:Bind ViewModel.HasUnsavedChanges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Command="{x:Bind ViewModel.CheckConfigCommand}"
                                        Content="检查配置"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="使用 sing-box 检查当前配置"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="高级 JSON" VerticalAlignment="Center"/>
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsAdvancedMode, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Command="{x:Bind ViewModel.SaveConfigCommand}"
                                        Content="保存配置"
                                        Style="{StaticResource AccentButtonStyle}"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

            <StackPanel Grid.Row="1" Spacing="14"
                        Visibility="{x:Bind ViewModel.IsAdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Reverse}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Header="默认出口" ItemsSource="{x:Bind ViewModel.OutboundTags}" IsEditable="True"
                              IsEnabled="{x:Bind ViewModel.CanEditRules, Mode=OneWay}"
                              Text="{x:Bind ViewModel.FinalOutbound, Mode=TwoWay}" HorizontalAlignment="Stretch"
                              PlaceholderText="留空使用内核默认值"/>
                    <ComboBox Grid.Column="1" Header="默认 DNS 解析器" ItemsSource="{x:Bind ViewModel.DnsTags}" IsEditable="True"
                              IsEnabled="{x:Bind ViewModel.CanEditRules, Mode=OneWay}"
                              Text="{x:Bind ViewModel.DefaultDomainResolver, Mode=TwoWay}" HorizontalAlignment="Stretch"
                              PlaceholderText="留空使用内核默认值"/>
                    <ToggleSwitch Grid.Column="2" Header="自动检测接口"
                                  IsEnabled="{x:Bind ViewModel.CanEditRules, Mode=OneWay}"
                                  IsOn="{x:Bind ViewModel.AutoDetectInterface, Mode=TwoWay}"/>
                </Grid>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.RuleCountText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="+ 添加规则" Click="AddRule_Click"
                            IsEnabled="{x:Bind ViewModel.CanEditRules, Mode=OneWay}"/>
                </Grid>
                <TextBlock Text="按从上到下的顺序匹配。展开规则后选择匹配类型；新增、删除和排序均在保存配置后生效。"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                <TextBlock Text="暂无路由规则，点击“添加规则”开始。"
                           Visibility="{x:Bind ViewModel.NoRules, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <ListView x:Name="RulesList" ItemsSource="{x:Bind ViewModel.RouteRules}" SelectionMode="None"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:RouteRule">
                            <Border Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button Content="↑" Tag="{x:Bind}" Click="MoveRuleUp_Click" AutomationProperties.Name="上移规则" ToolTipService.ToolTip="上移规则"/>
                                            <Button Content="↓" Tag="{x:Bind}" Click="MoveRuleDown_Click" AutomationProperties.Name="下移规则" ToolTipService.ToolTip="下移规则"/>
                                            <Button Content="删除" Tag="{x:Bind}" Click="RemoveRule_Click" AutomationProperties.Name="删除规则"/>
                                        </StackPanel>
                                    </Grid>
                                    <Expander IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        </Expander.Header>
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <ComboBox Header="执行动作" ItemsSource="{x:Bind ActionOptions}" SelectedItem="{x:Bind Action, Mode=TwoWay}"
                                                          HorizontalAlignment="Stretch"/>
                                                <TextBox Grid.Column="1" Header="出口标签" Text="{x:Bind Outbound, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="route 时指定，如 direct / remote"/>
                                            </Grid>
                                            <TextBlock Text="{x:Bind AdvancedNote}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <StackPanel Spacing="8" Visibility="{x:Bind IsSimple, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="匹配条件" FontWeight="SemiBold"/>
                                                <ItemsControl ItemsSource="{x:Bind Conditions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:RouteMatchCondition">
                                                            <Grid ColumnSpacing="8" Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="160"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ComboBox ItemsSource="{x:Bind Options}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                                                          SelectedValue="{x:Bind Field, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                                                          VerticalAlignment="Top" AutomationProperties.Name="匹配类型"/>
                                                                <TextBox Grid.Column="1" Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         PlaceholderText="{x:Bind Hint, Mode=OneWay}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100"
                                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="匹配内容"
                                                                         Visibility="{x:Bind IsBoolean, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Reverse}"/>
                                                                <ToggleSwitch Grid.Column="1" IsOn="{x:Bind BooleanValue, Mode=TwoWay}" OnContent="是" OffContent="否"
                                                                              AutomationProperties.Name="匹配私有 IP"
                                                                              Visibility="{x:Bind IsBoolean, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                                <Button Grid.Column="2" Content="移除" Tag="{x:Bind}" Click="RemoveCondition_Click"
                                                                        VerticalAlignment="Top" AutomationProperties.Name="移除匹配条件"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="+ 添加条件" Tag="{x:Bind}" Click="AddCondition_Click"/>
                                                <TextBlock Text="不同类型的条件通常需要同时满足；同一类型的多个值填写在同一项中。无条件规则会匹配所有流量。"
                                                           TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button Content="+ 添加规则" Click="AddRule_Click" HorizontalAlignment="Left"
                        IsEnabled="{x:Bind ViewModel.CanEditRules, Mode=OneWay}"/>
            </StackPanel>


            <TextBox Grid.Row="1"
                     Text="{x:Bind ViewModel.ConfigText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     FontFamily="Consolas"
                     FontSize="13"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     IsSpellCheckEnabled="False"
                     MinHeight="520"
                     Visibility="{x:Bind ViewModel.IsAdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   TextWrapping="Wrap" MaxHeight="96"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
    </Grid>
</Page>
