<Page
    x:Class="singC.Pages.SettingsPage"
    x:Name="ThisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:singC.Converters"
    xmlns:models="using:singC.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:BoolToStringConverter x:Key="BoolToStringConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="2">
                <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="管理运行路径、配置文件和路由规则"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="14">
                <Border Padding="14" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="个人服务" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="地址保存在本机，留空则不连接。请输入完整的 HTTP 或 HTTPS 地址。" TextWrapping="Wrap"/>
                        <TextBox x:Name="TrafficServiceUrlBox" Header="流量查询接口" PlaceholderText="https://example.com/traffic"/>
                        <Button Content="保存服务地址" Click="SaveServiceUrls_Click"/>
                        <TextBlock x:Name="ServiceUrlStatus" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Text="路径设置" Style="{StaticResource SubtitleTextBlockStyle}"/>

                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Sing-Box" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBox Grid.Column="1"
                                     Text="{x:Bind ViewModel.SingBoxPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="例如：C:\sing-box\sing-box.exe"/>
                            <Button Grid.Column="2" Command="{x:Bind ViewModel.BrowseSingBoxCommand}" ToolTipService.ToolTip="选择 Sing-Box 可执行文件">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                            </Button>

                            <TextBlock Grid.Row="1" Text="配置文件" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{x:Bind ViewModel.ConfigPaths}"
                                      SelectedItem="{x:Bind ViewModel.SelectedConfigPath, Mode=TwoWay}"
                                      PlaceholderText="选择要加载的配置文件"
                                      HorizontalAlignment="Stretch"/>
                            <Button Grid.Row="1" Grid.Column="2" Command="{x:Bind ViewModel.BrowseConfigCommand}" ToolTipService.ToolTip="添加配置文件">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14"/>
                            </Button>
                            <Button Grid.Row="1" Grid.Column="3" Command="{x:Bind ViewModel.RemoveConfigCommand}" ToolTipService.ToolTip="移除当前配置">
                                <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            </Button>

                            <TextBlock Grid.Row="2" Text="背景图片" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{x:Bind ViewModel.BackgroundImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="选择一张图片作为背景"/>
                            <Button Grid.Row="2" Grid.Column="2" Command="{x:Bind ViewModel.BrowseBackgroundCommand}" ToolTipService.ToolTip="选择背景图片">
                                <FontIcon Glyph="&#xEB9F;" FontSize="14"/>
                            </Button>
                            <Button Grid.Row="2" Grid.Column="3" Command="{x:Bind ViewModel.ClearBackgroundCommand}" ToolTipService.ToolTip="清除背景">
                                <FontIcon Glyph="&#xE894;" FontSize="14"/>
                            </Button>
                        </Grid>
                        <ToggleSwitch Header="开机启动"
                                      IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <Border Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="配置备份" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock Text="保存配置时自动保留最近 10 份备份。"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{x:Bind ViewModel.LoadConfigCommand}"
                                    ToolTipService.ToolTip="重新加载当前配置">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            </Button>
                        </Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.ConfigBackups}"
                                  SelectionMode="None"
                                  MaxHeight="150"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ConfigBackupInfo">
                                    <Grid ColumnSpacing="8" Padding="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind DisplayText}"
                                                   IsTextSelectionEnabled="True"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                            <Button Command="{Binding ElementName=ThisPage, Path=ViewModel.RestoreBackupCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTipService.ToolTip="恢复此备份">
                                                <FontIcon Glyph="&#xE777;" FontSize="13"/>
                                            </Button>
                                            <Button Command="{Binding ElementName=ThisPage, Path=ViewModel.DeleteBackupCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTipService.ToolTip="删除此备份">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid RowSpacing="10" Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Spacing="2">
                                <TextBlock Text="Sing-Box 配置" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock Text="简易模式编辑常用路由项，高级模式直接编辑 JSON"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="有未保存修改"
                                           Foreground="#C42B1C"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0"
                                           Visibility="{x:Bind ViewModel.HasUnsavedChanges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Command="{x:Bind ViewModel.CheckConfigCommand}"
                                        Content="检查配置"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="使用 sing-box 检查当前配置"/>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="高级模式" VerticalAlignment="Center"/>
                                    <ToggleSwitch IsOn="{x:Bind ViewModel.IsAdvancedMode, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Command="{x:Bind ViewModel.SaveConfigCommand}"
                                        Content="保存配置"
                                        Style="{StaticResource AccentButtonStyle}"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          Visibility="{x:Bind ViewModel.IsAdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Reverse}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Header="Final 出口"
                                  SelectedValue="{x:Bind ViewModel.FinalOutbound, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="remote"/>
                            <ComboBoxItem Content="direct"/>
                            <ComboBoxItem Content="bypass"/>
                        </ComboBox>

                        <ComboBox Grid.Column="1"
                                  Header="DNS 解析器"
                                  SelectedValue="{x:Bind ViewModel.DefaultDomainResolver, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="local"/>
                            <ComboBoxItem Content="remote"/>
                            <ComboBoxItem Content="prefer-local"/>
                        </ComboBox>

                        <ToggleSwitch Grid.Column="2"
                                      Header="自动检测接口"
                                      IsOn="{x:Bind ViewModel.AutoDetectInterface, Mode=TwoWay}"/>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="路由规则"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.AddRuleCommand}"
                                ToolTipService.ToolTip="添加路由规则">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                <TextBlock Text="添加规则"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.RouteRules}"
                              SelectionMode="None"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:RouteRule">
                                <Border BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Padding="12">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ComboBox Header="动作" SelectedValue="{x:Bind Action, Mode=TwoWay}">
                                                <ComboBoxItem Content="sniff"/>
                                                <ComboBoxItem Content="hijack-dns"/>
                                                <ComboBoxItem Content="reject"/>
                                                <ComboBoxItem Content="route"/>
                                            </ComboBox>

                                            <ComboBox Grid.Column="1" Header="协议" SelectedValue="{x:Bind Protocol, Mode=TwoWay}">
                                                <ComboBoxItem Content=""/>
                                                <ComboBoxItem Content="dns"/>
                                                <ComboBoxItem Content="http"/>
                                                <ComboBoxItem Content="tls"/>
                                                <ComboBoxItem Content="quic"/>
                                            </ComboBox>

                                            <ComboBox Grid.Column="2" Header="网络" SelectedValue="{x:Bind Network, Mode=TwoWay}">
                                                <ComboBoxItem Content=""/>
                                                <ComboBoxItem Content="tcp"/>
                                                <ComboBoxItem Content="udp"/>
                                            </ComboBox>

                                            <NumberBox Grid.Column="3"
                                                       Header="端口"
                                                       Value="{x:Bind PortDouble, Mode=TwoWay}"
                                                       Minimum="0"
                                                       Maximum="65535"
                                                       SpinButtonPlacementMode="Compact"/>

                                            <TextBox Grid.Column="4"
                                                     Header="出口"
                                                     Text="{x:Bind Outbound, Mode=TwoWay}"
                                                     PlaceholderText="direct / remote"/>

                                            <Button Grid.Column="5"
                                                    Command="{Binding ElementName=ThisPage, Path=ViewModel.MoveRuleUpCommand}"
                                                    CommandParameter="{x:Bind}"
                                                    ToolTipService.ToolTip="上移">
                                                <FontIcon Glyph="&#xE70E;" FontSize="12"/>
                                            </Button>
                                            <Button Grid.Column="6"
                                                    Command="{Binding ElementName=ThisPage, Path=ViewModel.MoveRuleDownCommand}"
                                                    CommandParameter="{x:Bind}"
                                                    ToolTipService.ToolTip="下移">
                                                <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                                            </Button>
                                            <Button Grid.Column="7"
                                                    Command="{Binding ElementName=ThisPage, Path=ViewModel.RemoveRuleCommand}"
                                                    CommandParameter="{x:Bind}"
                                                    ToolTipService.ToolTip="删除">
                                                <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                            </Button>
                                        </Grid>

                                        <Grid Grid.Row="1" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{x:Bind RuleSet, Mode=TwoWay}"
                                                     Header="规则集"
                                                     PlaceholderText="geosite-cn,geoip-cn"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{x:Bind DomainSuffix, Mode=TwoWay}"
                                                     Header="域名后缀"
                                                     PlaceholderText="cn,google.com"/>
                                        </Grid>

                                        <Grid Grid.Row="2" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{x:Bind IpCidr, Mode=TwoWay}"
                                                     Header="IP/CIDR"
                                                     PlaceholderText="1.1.1.1, 10.0.0.0/8"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{x:Bind Domain, Mode=TwoWay}"
                                                     Header="精确域名"
                                                     PlaceholderText="google.com, youtube.com"/>
                                            <CheckBox Grid.Column="2"
                                                      Content="本地 IP"
                                                      IsChecked="{x:Bind IpIsPrivate, Mode=TwoWay}"
                                                      VerticalAlignment="Bottom"
                                                      Margin="0,0,0,4"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <TextBox Grid.Row="1"
                     Text="{x:Bind ViewModel.ConfigText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     FontFamily="Consolas"
                     FontSize="13"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     IsSpellCheckEnabled="False"
                     MinHeight="520"
                     Visibility="{x:Bind ViewModel.IsAdvancedMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
    </Grid>
</Page>
