<Page
    x:Class="singC.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:singC.Pages"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <Style x:Key="ModeSegmentStyle" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="SegmentRoot" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="SegmentContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters><Setter Target="SegmentRoot.Opacity" Value="0.7"/></VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters><Setter Target="SegmentRoot.Opacity" Value="0.4"/></VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked"/>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="SegmentBorder.Background" Value="{ThemeResource ControlSolidFillColorDefaultBrush}"/>
                                            <Setter Target="SegmentBorder.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                                            <Setter Target="SegmentContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                            <Setter Target="SegmentContent.FontWeight" Value="SemiBold"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="SegmentBorder" Padding="6,4" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="Transparent" Background="Transparent">
                                <ContentPresenter x:Name="SegmentContent" Content="{TemplateBinding Content}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch" SizeChanged="HomeViewport_SizeChanged">
        <Grid x:Name="HomeCanvas" Height="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleTextBlock" Text="首页" Style="{StaticResource TitleTextBlockStyle}"
                       Margin="24,16,24,0" VerticalAlignment="Top"/>
            <StackPanel Grid.Row="1" Spacing="8" HorizontalAlignment="Center" Margin="16,0">
                <TextBlock x:Name="BackgroundText" Text="当前背景" Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="NoBackgroundText" Text="涉密不上网，上网不涉密" TextWrapping="Wrap"
                           TextAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
            </StackPanel>
            <StackPanel x:Name="ControlDock" Grid.Row="2" Width="520" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" Margin="0,24,0,24" Spacing="8">
                <InfoBar x:Name="OperationFeedback" IsOpen="False" IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button x:Name="ErrorDetailsButton" Content="查看详情" Visibility="Collapsed">
                            <Button.Flyout>
                                <Flyout>
                                    <ScrollViewer MaxHeight="280" MaxWidth="360">
                                        <TextBlock x:Name="ErrorDetailsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>
                <Border Padding="12,8" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ProgressRing x:Name="OperationProgress" Width="16" Height="16" MinWidth="0" MinHeight="0"
                                              IsActive="False" Visibility="Collapsed"/>
                                <TextBlock x:Name="StateTextBlock" Text="未运行" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                            <StackPanel x:Name="SpeedPanel" Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4" ToolTipService.ToolTip="下载速度">
                                    <TextBlock Text="↓" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                    <TextBlock x:Name="DownloadSpeedText" Text="—" MinWidth="76" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" ToolTipService.ToolTip="上传速度">
                                    <TextBlock Text="↑" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                    <TextBlock x:Name="UploadSpeedText" Text="—" MinWidth="76" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="ToggleServiceButton" Grid.Column="2" Content="启动" Click="ToggleServiceButton_Click"
                                    Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Width="104"
                                    Height="30" MinHeight="30" Padding="12,3"/>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="228"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Padding="2" CornerRadius="7" Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                                <Grid x:Name="ModeSelector" ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Tag="0" Content="跟随配置" GroupName="HomeMode" Checked="Mode_Checked" Style="{StaticResource ModeSegmentStyle}"/>
                                    <RadioButton Grid.Column="1" Tag="1" Content="TUN" GroupName="HomeMode" Checked="Mode_Checked" Style="{StaticResource ModeSegmentStyle}"/>
                                    <RadioButton Grid.Column="2" Tag="2" Content="系统代理" GroupName="HomeMode" Checked="Mode_Checked" Style="{StaticResource ModeSegmentStyle}"/>
                                </Grid>
                            </Border>
                            <ComboBox x:Name="ConfigComboBox" Grid.Column="1" ItemsSource="{x:Bind ConfigPaths}"
                                      SelectionChanged="ConfigComboBox_SelectionChanged" PlaceholderText="选择启动配置"
                                      AutomationProperties.Name="当前配置" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:HomeConfigOption">
                                        <TextBlock Text="{x:Bind DisplayName}" ToolTipService.ToolTip="{x:Bind FullPath}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="2" Width="34" Padding="6" AutomationProperties.Name="更多设置"
                                    ToolTipService.ToolTip="更多设置">
                                <FontIcon Glyph="&#xE712;" FontSize="16"/>
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Width="260" Spacing="12">
                                            <TextBlock Text="运行设置" FontWeight="SemiBold"/>
                                            <StackPanel x:Name="ProxyPortPanel" Visibility="Collapsed" Spacing="8">
                                                <NumberBox x:Name="ProxyPortBox" Header="本地代理端口" Value="7890" Minimum="1" Maximum="65535"
                                                           SpinButtonPlacementMode="Compact"/>
                                                <Button x:Name="ApplyProxyPortButton" Content="应用端口" Click="ApplyProxyPortButton_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="跟随配置：使用配置文件中的入站方式。" TextWrapping="Wrap"/>
                                            <TextBlock Text="TUN：通过虚拟网卡接管流量，需要以管理员身份运行。" TextWrapping="Wrap"/>
                                            <TextBlock Text="系统代理：设置 Windows 代理，同时提供本地 HTTP/SOCKS 入口。" TextWrapping="Wrap"/>
                                            <TextBlock Text="运行中切换会短暂中断连接；失败时恢复原模式。" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
