<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="singC.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:singC"
    xmlns:models="using:singC.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:helpers="using:singC.Helpers"
    mc:Ignorable="d"
    Title="singC">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <SplitView
            x:Name="MainSplitView"
            DisplayMode="CompactInline"
            OpenPaneLength="220"
            CompactPaneLength="50"
            PaneBackground="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            IsPaneOpen="True">

            <!-- 左侧导航面板 -->
            <SplitView.Pane>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 汉堡按钮（切换导航栏开合） -->
                    <ToggleButton
                        x:Name="HamburgerButton"
                        Grid.Row="0"
                        Margin="12"
                        FontFamily="Segoe MDL2 Assets"
                        Content="&#xE700;"
                        Click="HamburgerButton_Click"
                        ToolTipService.ToolTip="切换导航栏"/>

                    <!-- 导航菜单列表 -->
                    <ListView
                        x:Name="NavListView"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="NavListView_SelectionChanged"
                        ItemsSource="{x:Bind NavItems}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:NavItem">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,8">
                                    <TextBlock Text="{x:Bind Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                                    <TextBlock Text="{x:Bind Label}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="2"
                    Margin="12,8"
                    Spacing="4"
                    >

                        <TextBlock x:Name="TittleText" 
                       Text="流量统计"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondary}"/>

                        <TextBlock x:Name="UsedText"
                       Text="已使用流量: --"
                       FontSize="12"/>

                        <TextBlock x:Name="RemainText"
                       Text="剩余流量: --"
                       FontSize="12"/>

                        <TextBlock x:Name="ResetTimeText"
                       Text="重置时间: --"
                       FontSize="12"/>
                        <!-- 如果不需要可隐藏 -->

                        <TextBlock x:Name="UpdateTimeText"
                       Text="更新: --"
                       FontSize="10"
                       Foreground="{ThemeResource TextFillColorTertiary}"/>
                    </StackPanel>
                </Grid>
            </SplitView.Pane>

            <!-- 右侧内容区：用 Frame 加载 Page -->
            <SplitView.Content>
                <Frame x:Name="ContentFrame"/>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Window>
